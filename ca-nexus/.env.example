# Copy to .env and fill secrets. Never commit real .env.
# Do NOT just copy defaults to production: JWT_SECRET and bootstrap password are placeholders.
POSTGRES_USER=mkh
POSTGRES_PASSWORD=mkh_password
POSTGRES_DB=mkh
POSTGRES_PORT=5432
QDRANT_PORT=6333
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Random min-32-char secret, e.g. output of: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE-ME
# Session cookie: httpOnly + SameSite=Lax. Same-origin/sub-path deploys work as-is.
# Cross-domain (app.example.com + api.example.com) needs COOKIE_SECURE=true (HTTPS)
# and SameSite=None — change samesite in auth.py::_set_auth_cookie accordingly.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# LLM provider keys (OpenRouter-first per D-16; at least one for live answers)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Monthly LLM spend guard (USD estimate, EXAMPLE rates): 0 = unlimited.
# When reached, generation stops; SQL/extractive/lexical answers keep working.
BUDGET_USD_CAP=0
# Bootstrap super admin — leave empty to skip seeding (preferred after first bootstrap).
# Re-runs never duplicate: existing email is skipped, credentials never overwritten.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMPLOYEE_ID=ADM-0001
BOOTSTRAP_ADMIN_DIVISION=Mechanical
